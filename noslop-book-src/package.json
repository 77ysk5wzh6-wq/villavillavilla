{
  "name": "villa-paper-book",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild viewer.ts --bundle --minify --format=iife --target=es2020 --outfile=../noslop-book-assets/viewer.js --legal-comments=linked",
    "test": "npm run test:engine && npm run test:ui && npm run test:preload && npm run test:sound && npm run test:theme",
    "test:engine": "esbuild engine.ts --bundle --platform=node --format=cjs --outfile=.test-build/engine.cjs && node tests/interaction.test.cjs",
    "test:ui": "esbuild ui-idle.ts --bundle --platform=node --format=cjs --outfile=.test-build/ui-idle.cjs && node tests/ui-idle.test.cjs",
    "test:preload": "esbuild preload.ts --bundle --platform=node --format=cjs --outfile=.test-build/preload.cjs && node tests/preload.test.cjs",
    "test:sound": "esbuild sound-player.ts --bundle --platform=node --format=cjs --outfile=.test-build/sound-player.cjs && node tests/sound-player.test.cjs",
    "test:theme": "esbuild theme-transition.ts --bundle --platform=node --format=cjs --outfile=.test-build/theme-transition.cjs && node tests/theme-transition.test.cjs"
  },
  "dependencies": { "three": "0.162.0" },
  "devDependencies": { "esbuild": "0.25.12" }
}
